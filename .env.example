# Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → Database → Connection string
# App (serverless) uses the Transaction pooler, port 6543:
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Migrations use the Session pooler / direct connection, port 5432:
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Auth.js: generate with `npx auth secret` (or: openssl rand -base64 33)
AUTH_SECRET=""
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Only these Google accounts can sign in (comma-separated)
ALLOWED_EMAILS=""

# Any long random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=""

# Phase 3+ (LLM planner) — not needed yet
# ANTHROPIC_API_KEY=""
